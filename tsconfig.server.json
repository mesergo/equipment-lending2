{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "server-build",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["server/**/*.ts", "src/data/mockData.ts", "src/types/index.ts"]
}
