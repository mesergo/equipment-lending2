# GEMINI_API_KEY: powers the AI natural-language catalog search (server/aiSearchRoutes.ts) - lets
# a customer describe what they need in plain Hebrew ("משהו שעוזר לקום מהמיטה") instead of having
# to pick a category or know the exact product name. Get a free key at https://aistudio.google.com/apikey.
# Optional: if left as the placeholder below (or unset), the catalog search still works normally -
# it just won't get the extra AI-matched results. See the README's AI search section.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Local auth server (server/index.ts) ---

# JWT_SECRET: signs the login session tokens. Set this to a long random string
# (e.g. `openssl rand -hex 32`) and keep it out of git — it already is via .env being gitignored.
# Changing it instantly logs everyone out (all existing tokens stop verifying).
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# AUTH_SERVER_PORT: port the local Express auth server listens on. Defaults to 4001.
AUTH_SERVER_PORT="4001"

# --- WhatsApp return reminders (server/whatsapp.ts, server/reminders.ts) ---

# WHATSAPP_PROVIDER: "console" (default) just logs what would be sent — to the server console
# and to server/data/whatsapp-log.jsonl — no WhatsApp account needed. Set to "meta" or "twilio"
# once you've picked and set up a real provider (see server/whatsapp.ts for what each still needs).
WHATSAPP_PROVIDER="console"

# REMINDER_CHECK_INTERVAL_MINUTES: how often the server checks whether any order needs today's
# reminder. A day-based "once per order per day" guard means this can safely run often — lower
# it (e.g. to 2) while testing so you don't have to wait an hour to see it fire.
REMINDER_CHECK_INTERVAL_MINUTES="60"

# --- One-time remote setup (server/setupRoutes.ts) - only needed on a host where you have no
# SSH/terminal access to run `npm run seed:users` yourself, e.g. plain FTP + a control panel. ---

# SETUP_SECRET: leave this UNSET normally. Only set it (to a random string) temporarily, right
# after first deploying to a host with no terminal access, so you can call POST
# /api/setup/seed-users?secret=<this value> once from a browser/curl to create the starter
# accounts remotely. Unset it again immediately after - see the README's deployment section.
# SETUP_SECRET="MY_TEMPORARY_SETUP_SECRET"
